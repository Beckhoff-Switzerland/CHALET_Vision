      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Access to the important parameters marked as standard in Gige-Vision
PROPERTY RegisterAnyCamera : I_GigE_Any_Camera]]></Declaration>
      <Get Name="Get" Id="{0420c097-062d-482b-8cb1-5ce6c81ddc73}">
