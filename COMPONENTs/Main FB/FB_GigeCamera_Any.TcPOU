    <Property Name="State" Id="{50e80ae9-2935-4fb3-9258-b3bc964b950f}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Gets the current state of the internal camera control state machine.
PROPERTY State : ETcVnCameraState]]></Declaration>
      <Get Name="Get" Id="{403fa147-7caa-45cc-b95d-19e7e59994e7}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[State := THIS^.fbCamera.GetState();]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="TriggerEtherCat" Id="{d56cc878-4ab2-4eaf-906d-a4f6451fdf4c}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Access to the interface to control the EtherCAT timestamp trigger
PROPERTY TriggerEtherCat : I_EtherCat_Trigger]]></Declaration>
      <Get Name="Get" Id="{5511c542-b995-4328-b8d3-a625ef59ee40}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[TriggerEtherCat := THIS^.fbTriggerEtherCat;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TriggerSoftware" Id="{eebc06d9-4bb8-48c3-8885-1edcdf59cd74}">
      <Declaration><![CDATA[//Send the 'SoftwareTriggerCommands' defined in the TcVnGevImageProvider TcCOM module to the camera.
METHOD PUBLIC TriggerSoftware : HRESULT
VAR
	eState : ETcVnCameraState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eState := THIS^.State;

(* Check if not in wrong state *)
IF NOT ((eState = ETcVnCameraState.TCVN_CS_ACQUIRING) OR (eState = ETcVnCameraState.TCVN_CS_OPENED) OR THIS^.Simulation) THEN
	TriggerSoftware := E_FAIL;
	RETURN;
END_IF

// Trigger image
fbFeedback.ActiveCommand := 'TriggerImage';
fbFeedback.LastCommandAccepted	:= TRUE;
fbFeedback.hr := fbCamera.TriggerImage();
TriggerSoftware := fbFeedback.hr;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryGetImage" Id="{a7872ab3-e0b7-44ca-a9ad-ab28324c5ff8}">
      <Declaration><![CDATA[//Gets the current available image (first in receive queue) and its corresponding GVSP info
METHOD TryGetImage : HRESULT
VAR_INPUT
	stImageWithInfo : REFERENCE TO ST_ImageWithInfo;
END_VAR
VAR_INST
	{attribute 'hide'}							
    fbCrititcalSection : FB_IecCriticalSection;    						// Internal lock for test & set function    
END_VAR
VAR
	ipImageTemp   : ITcVnImage;
	stGvspInfoTemp : GVSP_IMAGE_INFO;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(stImageWithInfo) THEN
	//Error, invalide input
	TryGetImage := E_FAIL;
	RETURN;
END_IF


(*  Lock the image to prevent multiple access *)
(*	🔒 LOCKED FROM HERE --------------------------------------------- *)
IF fbCrititcalSection.Enter() THEN
	
	(* Get current image from camera and store result in temp variable*)
	TryGetImage := fbCamera.GetCurrentImageWithGvspInfo(
						ipImage := ipImageTemp,
						stGvspInfo := stGvspInfoTemp
						);
					
	(* If new image found *)				
	IF TryGetImage = S_OK THEN
		
		(* Release the old image before overwriting it with the new one *)	
		IF stImageWithInfo.ipImage <> 0 THEN
			FW_SafeRelease(ADR(stImageWithInfo.ipImage));
		END_IF		
	
		//Handover new data
		stImageWithInfo.ipImage 		:= ipImageTemp;
		stImageWithInfo.stGvspInfo 		:= stGvspInfoTemp;

		(*For a camera a fictitious name *)
		stImageWithInfo.sCurrentImageFileName := TO_STRING(stImageWithInfo.stGvspInfo.BlockId);		

		
		(* Get image info from received image *)
		F_VN_GetImageInfo(	ipImage:=stImageWithInfo.ipImage, 
							stImageInfo:=stImageWithInfo.stInfo, 
							hrPrev:=TryGetImage );	
	END_IF



	(*	🔓 LOCKED TO HERE ----------------------------------------------- *)
	fbCrititcalSection.Leave();
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Update" Id="{f47126a0-8dd0-475c-9002-45ef62606169}">
      <Declaration><![CDATA[METHOD Update : HRESULT
VAR
	ipVnRegisterStatus : I_VnRegister;
	bAllReadDone : BOOL := TRUE;
	bAllWriteDone : BOOL := TRUE;
	nParaSize : UDINT;
	pParaData : PVOID;
	hr : HRESULT;
	stIpStackData : ST_IpStackDiag;
	bLinkDetected : BOOL;
	bParaReadSuccessful : BOOL;
END_VAR
VAR CONSTANT
	N_IDX_OFFSET_IP_STACK 	: UDINT := 16#03011108; // Parameter(online) in Planar Track object
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Force to initialize first
IF NOT THIS^.Initialized THEN
	THIS^.Initialize();
	RETURN;
END_IF


(* Source state machine *)
CASE THIS^.State OF
	TCVN_CS_INITIAL, TCVN_CS_INITIALIZING:
		fbFeedback.ActiveCommand := 'InitializeCamera';
		fbFeedback.hr := fbCamera.InitializeCamera();

	TCVN_CS_INITIALIZED,  TCVN_CS_OPENING:	
		IF THIS^.ipRegister <> 0 THEN
			//Redo a read or write for each parameter
			THIS^.ipRegister.RewriteParameters();
		END_IF
		fbFeedback.ActiveCommand := 'OpenCamera';
		fbFeedback.hr := fbCamera.OpenCamera();
		
	TCVN_CS_OPENED:
		(* Detect camera model once if unknown *)
		IF THIS^.CameraType = E_CameraType.Unknown AND THIS^.RegisterAnyCamera <> 0 AND THIS^.ipRegister.AllReadDone THEN
			IF FIND(THIS^.RegisterAnyCamera.DeviceModeNamel, 'VCS2') <> 0 THEN
				THIS^.CameraType := E_CameraType.Beckhoff_VCS2xxx;
			ELSIF FIND(THIS^.RegisterAnyCamera.DeviceModeNamel, 'VUI2') <> 0 THEN
				THIS^.CameraType := E_CameraType.Beckhoff_VUI2xxx;
			ELSE
				THIS^.CameraType := E_CameraType.ThirdParty;
			END_IF
		END_IF
		
		IF THIS^.Simulation THEN
			; //Stay in this state in Simulationmode	
		
		ELSIF THIS^.ipRegister = 0 THEN
			fbFeedback.ActiveCommand := 'StartAcquisition';
			fbFeedback.hr := fbCamera.StartAcquisition();
			
		ELSIF THIS^.ipRegister.AllReadDone AND THIS^.ipRegister.AllWriteDone THEN
			fbFeedback.ActiveCommand := 'StartAcquisition';
			fbFeedback.hr := fbCamera.StartAcquisition();

		ELSE	
			//Read and write all camera parameter in this OPENED-State 
			fbFeedback.ActiveCommand := 'ReadWrite camera parameters';
			fbFeedback.Busy	:= TRUE;
		END_IF
	
		
	TCVN_CS_STARTACQUISITION:
		fbFeedback.ActiveCommand := 'StartAcquisition';
		fbFeedback.hr := fbCamera.StartAcquisition();
		
		
	TCVN_CS_STOPACQUISITION:
		fbFeedback.ActiveCommand := 'StopAcquisition';
		fbFeedback.hr := fbCamera.StopAcquisition();
		
	TCVN_CS_ACQUIRING:
		;//wait for trigger
		
		//Check if a chage in opened state is required to read/write parameter
		IF VisionParameterlist.B_LEAVE_AQUIRRING_STATE_TO_WRITE_PARAMETER AND THIS^.ipRegister <> 0 AND_THEN NOT THIS^.ipRegister.AllWriteDone THEN
			fbFeedback.ActiveCommand := 'StopAcquisition';
			fbCamera.StopAcquisition();
		END_IF
		
	TCVN_CS_TRIGGERING:
		(* Execute the triggering until done *)
		fbFeedback.ActiveCommand := 'TriggerImage';
		fbFeedback.hr := fbCamera.TriggerImage();
		
	TCVN_CS_ERROR:	
		(* Reset if commanded *)
		IF THIS^.bResetCommand THEN
			fbFeedback.ActiveCommand := 'Reset';
			fbFeedback.hr := THIS^.fbCamera.Reset();			
		END_IF
		
END_CASE

(* Clear reset request if not in Error-State *)
IF THIS^.State <> TCVN_CS_ERROR THEN
	THIS^.bResetCommand := FALSE;
END_IF




// --- Write diagnostic information to eventloger
IF THIS^.State = TCVN_CS_ERROR AND VisionParameterlist.B_ALARM_IF_LINK_TO_CAMERA_IS_DOWN THEN
	//check IP-Stack an check if camera is conected	
	IF THIS^.ipIpStackComObject <> 0 THEN
		//Read object id of ipStack TcCom 
		nParaSize := SIZEOF(stIpStackData);	pParaData := ADR(stIpStackData);
		hr := ipIpStackComObject.TcGetObjPara(	pid		:=N_IDX_OFFSET_IP_STACK , 
												nData	:= nParaSize, 
												pData	:= pParaData, 
												pgp		:=0 );
		
		 // Link is active on uneven cts of linkchanges
		bLinkDetected := (stIpStackData.nLinkStatusChangedCnt MOD 2) = 1;
		bParaReadSuccessful := hr = S_OK;
		IF NOT THIS^.Simulation AND bParaReadSuccessful AND NOT bLinkDetected AND NOT fbEthernetLinkDown.bRaised THEN
			fbEthernetLinkDown.CreateEx(stEventEntry 		:= TC_EVENTS.CHALET_Vision_Events.EthernetLinkDown,
										ipSourceInfo 		:= THIS^.fbSourceInfo,
										bWithConfirmation 	:= FALSE);
			fbEthernetLinkDown.Raise(0);			
	
		ELSIF fbEthernetLinkDown.bRaised AND (THIS^.Simulation AND NOT bParaReadSuccessful OR bLinkDetected) THEN
			fbEthernetLinkDown.Clear(0,0);		
			
		ELSE
			; //nothing
		END_IF
	END_IF
END_IF


//Subelement - if not in simulation
fbTriggerEtherCat.Update();

IF THIS^.ipRegister <> 0 THEN
	//Redo a read or write for each parameter
	THIS^.ipRegister.Update();
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>