<?xml version="1.0"?>
<TcModuleClass>
	<Translations>
		<Text TxtId="CHALET_Vision"/>
		<Text TxtId="ObjectID is not set in PLC_Instance"/>
		<Text TxtId="ObjectID is not set"/>
		<Text TxtId="enter a valid value in the PLC_Instance in the &quot;Symbol Initilization&quot; tab, e.g. for the image provider"/>
		<Text TxtId="Timeout in state {0}"/>
		<Text TxtId="The component did not react to the trigger."/>
		<Text TxtId="nSwitch_on_counter should have been increased"/>
		<Text TxtId="Reading the parameter failed"/>
		<Text TxtId="Write the parameter failed"/>
		<Text TxtId="Ethernet link to the camera is down"/>
		<Text TxtId="Ethernet cable is not connected or camera has no power"/>
	</Translations>
	<DataTypes>
		<DataType>
			<Name GUID="{52E35DF4-A053-4128-B32E-ED010E7F71B3}">CHALET_Vision_Events</Name>
			<DisplayName TxtId=""><![CDATA[CHALET_Vision]]></DisplayName>
			<EventId>
				<Name Id="1">ObjectIdNotSet</Name>
				<DisplayName TxtId=""><![CDATA[ObjectID is not set in PLC_Instance]]></DisplayName>
				<Severity>Error</Severity>
				<CauseRemedy Idx="1">
					<Cause TxtId=""><![CDATA[ObjectID is not set]]></Cause>
					<Remedy TxtId=""><![CDATA[enter a valid value in the PLC_Instance in the "Symbol Initilization" tab, e.g. for the image provider]]></Remedy>
				</CauseRemedy>
			</EventId>
			<EventId>
				<Name Id="2">TimeOut</Name>
				<DisplayName TxtId=""><![CDATA[Timeout in state {0}]]></DisplayName>
				<Severity>Error</Severity>
			</EventId>
			<EventId>
				<Name Id="3">NoReactionToTheTrigger</Name>
				<DisplayName TxtId=""><![CDATA[The component did not react to the trigger.]]></DisplayName>
				<Comment TxtId=""><![CDATA[nSwitch_on_counter should have been increased]]></Comment>
				<Severity>Error</Severity>
			</EventId>
			<EventId>
				<Name Id="4">RegReadError</Name>
				<DisplayName TxtId=""><![CDATA[Reading the parameter failed]]></DisplayName>
				<Severity>Error</Severity>
			</EventId>
			<EventId>
				<Name Id="5">RegWriteError</Name>
				<DisplayName TxtId=""><![CDATA[Write the parameter failed]]></DisplayName>
				<Severity>Error</Severity>
			</EventId>
			<EventId>
				<Name Id="6">EthernetLinkDown</Name>
				<DisplayName TxtId=""><![CDATA[Ethernet link to the camera is down]]></DisplayName>
				<Severity>Error</Severity>
				<CauseRemedy Idx="1">
					<Cause TxtId=""><![CDATA[Ethernet cable is not connected or camera has no power]]></Cause>
				</CauseRemedy>
			</EventId>
