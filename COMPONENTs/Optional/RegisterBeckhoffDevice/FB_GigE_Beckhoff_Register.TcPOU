    <Method Name="RewriteParameters" Id="{e13639d8-ac38-45c5-863f-42914df63fd2}">
      <Declaration><![CDATA[//Rewrite parameters if necessary, e.g. after a connection interruption
METHOD RewriteParameters : HRESULT
VAR
	ipRegObject : I_VnRegister;
	hr : HRESULT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.fbVnRegisterList.ResetIterator();
WHILE(THIS^.fbVnRegisterList.HasNextObject()) DO
	IF __QUERYINTERFACE(THIS^.fbVnRegisterList.GetNextObject(), ipRegObject) THEN
		hr := GetMostSignificant(hr, ipRegObject.RewriteParameters());
	END_IF
END_WHILE
THIS^.fbVnRegisterList.RestoreIterator();

RewriteParameters := hr;]]></ST>
      </Implementation>
    </Method>
