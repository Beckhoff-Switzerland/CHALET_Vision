<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.17">
  <POU Name="FB_GigE_Register_Beckhoff_VCS2xxx_HW" Id="{51a93bdd-6ce9-4bba-a57e-e20e8b2f4093}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'no_explicit_call' := 'Do not call the body - Stick to OOP'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_GigE_Register_Beckhoff_VCS2xxx_HW EXTENDS FB_GigE_Register_Any IMPLEMENTS I_GigE_Beckhoff_Camera, I_GigeRegisterBase
VAR	
	nExposure_1us 			AT %Q* : UDINT := 200;
	
	//GigE-Camera-Register
	//Read/Write
	{attribute 'hide'}
	fbRegAcquisitionMode 		: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pAcquisitionModeReg, nEndian := 0);
	{attribute 'hide'}                                                  
	fbRegTriggerMode	 		: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pTriggerModeFrameStartReg, nEndian := 0);
	{attribute 'hide'}                                                  
	fbRegTriggerSource	 		: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pTriggerSourceFrameStartReg, nEndian := 0);
	{attribute 'hide'}                                                  
	fbRegDeviceDefaultState		: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pDeviceDefaultStateReg, nEndian := 0);
	{attribute 'hide'}                                                  
	fbRegRegionModeOn			: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pRegion0ModeReg, nEndian := 0);
	{attribute 'hide'}                                                  
	fbRegRegionWidth			: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pRegion0WidthReg, nEndian := 0);
	{attribute 'hide'}                                                  
	fbRegRegionHeight			: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pRegion0HeightReg, nEndian := 0);
	{attribute 'hide'}                                                  
	fbRegRegionOffsetX			: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pRegion0OffsetXReg, nEndian := 0);
	{attribute 'hide'}                                                  
	fbRegRegionOffsetY			: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pRegion0OffsetYReg, nEndian := 0);
	{attribute 'hide'}                                                  
	fbRegGainAnalog				: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pGainBaseReg, nEndian := 0);
	                                                                    
	//Read only                                                         
	{attribute 'hide'}                                                  
	fbRegDeviceVersion	 		: FB_VnRegister_Memory(bReadOnly := TRUE, nAddress := E_CameraRegisters_Beckhoff.DeviceVersion, nLength := 32); //String		
	{attribute 'hide'}                                                  
	fbRegSensorName		 		: FB_VnRegister_Memory(bReadOnly := TRUE, nAddress := E_CameraRegisters_Beckhoff.SensorName, nLength := 80); //String	
	{attribute 'hide'}                                                  
	fbRegDeviceSerialNumber	 	: FB_VnRegister_Memory(bReadOnly := TRUE, nAddress := E_CameraRegisters_Beckhoff.DeviceSerialNumber, nLength := 16); //String	
	{attribute 'hide'}                                                  
	fbRegCurrentIPAddress	 	: FB_VnRegister_UDINT(bReadOnly := TRUE, nAddress := E_CameraRegisters_Beckhoff.BootStrap_IPAddress, nEndian := 0);  //T_IPv4AddrArr
	{attribute 'hide'}                                                 
	fbRegGevMACAddressHighWord	: FB_VnRegister_UDINT(bReadOnly := TRUE, nAddress := E_CameraRegisters_Beckhoff.pGevMACAddressHighWordReg, nEndian := 0);
	{attribute 'hide'}                                                 
	fbRegGevMACAddressLowWord	: FB_VnRegister_UDINT(bReadOnly := TRUE, nAddress := E_CameraRegisters_Beckhoff.pGevMACAddressLowWordReg, nEndian := 0);
	{attribute 'hide'}                                                 
	fbRegImgSensorWidth			: FB_VnRegister_UDINT(bReadOnly := TRUE, nAddress := E_CameraRegisters_Beckhoff.pPhysicalWidthReg, nEndian := 0);
	{attribute 'hide'}                                                 
	fbRegImgSensorHeight		: FB_VnRegister_UDINT(bReadOnly := TRUE, nAddress := E_CameraRegisters_Beckhoff.pPhysicalHeightReg, nEndian := 0);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="RegisterParameter" Id="{e9904f2a-9f63-4b39-b28a-52b9c383a578}">
      <Folder Name="Acquisition and Trigger" Id="{994f9c85-767c-4982-ac5a-d7b9abd55479}" />
      <Folder Name="Device" Id="{597aecce-04a3-4eb7-ab28-43b509a296ff}" />
      <Folder Name="Region" Id="{f4a5f9ca-4cec-4db1-8b31-3024f67fe84d}" />
