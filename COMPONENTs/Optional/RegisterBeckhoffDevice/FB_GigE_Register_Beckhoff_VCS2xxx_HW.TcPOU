    </Folder>
    <Property Name="AcquisitionMode" Id="{86fb26e9-9411-438b-a2d3-1a9f44b66859}" FolderPath="RegisterParameter\Acquisition and Trigger\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Number of frames captured in the acquisition. 
//SingleFrame: One frame is captured. 
//MultiFrame: The number of frames specified by AcquisitionFrameCount is captured. 
//Continuous: Frames are captured continuously until stopped with the AcquisitionStop command.
PROPERTY AcquisitionMode : E_AcquisitionModeReg]]></Declaration>
      <Get Name="Get" Id="{8a8e0918-949e-4590-9512-57388f071f06}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[AcquisitionMode := THIS^.fbRegAcquisitionMode.Value;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f3c318d4-6e5e-4ac4-8c45-724c816e81ce}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[fbRegAcquisitionMode.Value := AcquisitionMode;

]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="DeviceDefaultState" Id="{6b8cda19-76ba-4ed2-854e-297cc0f4610e}" FolderPath="RegisterParameter\Device\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Controls whether most of the camera settings is controlled by GigE Vision or EtherCAT. 
//A change from EtherCAT to GigE Vision requires a reboot.
PROPERTY DeviceDefaultState : E_DeviceDefaultState]]></Declaration>
      <Get Name="Get" Id="{f3f6e078-3363-47e5-8531-ccf246e2a229}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[DeviceDefaultState := THIS^.fbRegDeviceDefaultState.Value;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{119dd98c-94ed-4f56-8ef3-f72726f5d666}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[THIS^.fbRegDeviceDefaultState.Value := DeviceDefaultState;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="DeviceSerialNumber" Id="{7f742cf9-4a0c-41a0-996a-16556b46e4e9}" FolderPath="RegisterParameter\Device\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Device's serial number. This string is a unique identifier of the device.
