//Displays the device version which includes the firmware release and build.
PROPERTY DeviceVersion : STRING(32)]]></Declaration>
      <Get Name="Get" Id="{9d172982-5d57-4144-8d9e-fe696e2f532b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
