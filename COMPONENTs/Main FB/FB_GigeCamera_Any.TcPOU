<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="FB_GigeCamera_Any" Id="{e8c292d8-c8f1-47c5-8349-a7443f582da7}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'no_explicit_call' := 'Do not call the body - Stick to OOP'}
FUNCTION_BLOCK FB_GigeCamera_Any EXTENDS FB_CH_Object IMPLEMENTS I_GevCameraControl, I_GigE_Beckhoff_Standalone, I_GetImage
VAR
	// This FB provides the basic functionality to control a GigE Vision camera and access its calibration data.
	fbCamera 						: FB_VN_GevCameraControl;	
	fbTriggerEtherCat				: FB_EtherCAT_Timestamp;
	
	{attribute 'hide'}	
	bInSimulation 					: BOOL;
	{attribute 'hide'}	
	eCameraType						: E_CameraType; 	
	{attribute 'hide'}
	fbGigeAnyRegister			 			: FB_GigE_Register_Any(ipCamera := THIS^);
	{attribute 'hide'}
	fbGigeBeckhoffRegisterVCS2xxx 			: FB_GigE_Register_Beckhoff_VCS2xxx(ipCamera := THIS^);
	{attribute 'hide'}
	fbGigeBeckhoffRegisterVUI2xxx 			: FB_GigE_Register_Beckhoff_VUI2xxx(ipCamera := THIS^);
	{attribute 'hide'}	
	ipRegister 								: I_GigeRegisterBase := fbGigeAnyRegister;
		
	{attribute 'hide'}	
	bInitDone 			: BOOL;
	{attribute 'hide'}
	bResetCommand		: BOOL;
	{attribute 'hide'}  						
	fbFeedback 			: FB_CH_Feedback(THIS^.fbSourceInfo); 
	{attribute 'hide'}
	fbAlarmOidNotSet 	: FB_TcAlarm;									// Alarm due to source state
	{attribute 'hide'}
	fbEthernetLinkDown 	: FB_TcAlarm;									// Camera is not connectode or has no power
	
	//TcCom object Camera
	{attribute 'hide'}
	ipGevImageProviderComObject 		: ITComObject;	
	{attribute 'hide'}
	ipGevImageAcquisitionComObject 		: ITComObject;	
	{attribute 'hide'}
	ipIpStackComObject 					: ITComObject;			
END_VAR



]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="CameraType" Id="{7fb62898-c1ef-473f-8fa5-37fc744dfaeb}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Once as a Beckhoff camera is detected at startup, the corresponding type is loaded automatically. 
PROPERTY CameraType : E_CameraType]]></Declaration>
      <Get Name="Get" Id="{6fbdc49f-5dec-49b6-b3b2-6ecf421f6204}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CameraType := THIS^.eCameraType;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f1d50843-b071-4042-b7c8-71452311f410}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[//if a new type is selectet, init the last one to reset all errors
IF (THIS^.CameraType <> THIS^.eCameraType) AND (THIS^.ipRegister <> 0) THEN
	THIS^.ipRegister.Initialize();
END_IF

//store new type
THIS^.eCameraType := CameraType;

//write new object to interface
CASE THIS^.eCameraType OF	
	E_CameraType.Beckhoff_VCS2xxx:
		THIS^.ipRegister := THIS^.fbGigeBeckhoffRegisterVCS2xxx;
		
	E_CameraType.Beckhoff_VUI2xxx:
		THIS^.ipRegister := THIS^.fbGigeBeckhoffRegisterVUI2xxx;
	
	ELSE
		THIS^.ipRegister := THIS^.fbGigeAnyRegister;;
END_CASE]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ControlChannelOpen" Id="{9ac1a404-f3db-4ca1-8cf3-21dcc8494d47}">
      <Declaration><![CDATA[//	The connection to the camera has been established. Gige-Vision parameters can now be read or written
{attribute 'monitoring' := 'call'}
PROPERTY ControlChannelOpen : BOOL]]></Declaration>
      <Get Name="Get" Id="{18acef6b-5a92-4cac-8fe9-f38fe5906b7c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CASE THIS^.State OF
	TCVN_CS_ERROR, TCVN_CS_INITIAL, TCVN_CS_INITIALIZING, TCVN_CS_INITIALIZED,TCVN_CS_OPENING,TCVN_CS_CLOSING:
		ControlChannelOpen := FALSE;
	
	TCVN_CS_OPENED, TCVN_CS_STARTACQUISITION,  TCVN_CS_ACQUIRING, TCVN_CS_STOPACQUISITION, TCVN_CS_RESETTINGFEATURES, TCVN_CS_TRIGGERING:
		ControlChannelOpen := TRUE;

	ELSE
		;//Unknown
END_CASE

]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_exit" Id="{22a0fd36-0f2b-40fc-a0b7-e0a470e76283}">
      <Declaration><![CDATA[METHOD FB_exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL; // if TRUE, the exit method is called for exiting an instance that is copied afterwards (online change).
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Not on onlinechange
IF NOT bInCopyCode THEN
	IF THIS^.ipGevImageProviderComObject <> 0 THEN
		FW_SafeRelease(ADR(ipGevImageProviderComObject));
		FW_SafeRelease(ADR(ipGevImageAcquisitionComObject));
		FW_SafeRelease(ADR(ipIpStackComObject));
	END_IF	
END_IF


]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{6d48896f-0163-44cc-930b-b0132ca2b6f1}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
END_VAR
VAR
	fbGetCurTaskIdx  : GETCURTASKINDEX;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode THEN
	//Start with an unknown camera. 
	//Once as a Beckhoff camera is detected, the corresponding type is loaded automatically. 
	THIS^.CameraType := E_CameraType.Unknown;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Feedback" Id="{25a83ed1-35db-403a-8b79-b1707e7b3bf5}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
PROPERTY Feedback : I_CH_Feedback]]></Declaration>
      <Get Name="Get" Id="{05de5582-afd6-49ee-8b6a-a404cc9a5153}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Feedback := THIS^.fbFeedback;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="GevCameraControl" Id="{a6a5ff40-e698-4eb9-a4af-7e7b956de53b}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
// This FB provides the basic functionality to control a GigE Vision camera and access its calibration data.
PROPERTY GevCameraControl : REFERENCE TO FB_VN_GevCameraControl]]></Declaration>
      <Get Name="Get" Id="{4dbcaeb3-d198-410e-97c9-10d4ba383e48}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[GevCameraControl REF= THIS^.fbCamera;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Initialize" Id="{bc3ff501-3767-4510-b98a-2583f7f1bf51}">
      <Declaration><![CDATA[METHOD Initialize : HRESULT
VAR 
	fbTaskInfo			: PlcTaskSystemInfo;
	nOid : OTCID;	
	nParaSize : UDINT;
	pParaData : PVOID;
	hr : HRESULT;
END_VAR
VAR_INST
	//This error cannot be reset. Requires a reset cold
	{attribute 'hide'}	
	fbInitError : FB_TcAlarm;
END_VAR
VAR CONSTANT
	N_IDX_OFFSET_GevImageAcquisition 	: UDINT := 16#00000001;
	N_IDX_OFFSET_IP_STACK 				: UDINT := 16#00000013;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[hr := SUPER^.Initialize();


// Object id of ImagePoovider is not set
IF THIS^.fbCamera.oidITcVnGevImageProvider = 0 THEN
	IF NOT fbInitError.bRaised THEN 
		//This error cannot be reset. Requires a reset cold
		fbInitError.CreateEx(stEventEntry:=TC_EVENTS.CHALET_Vision_Events.ObjectIdNotSet, ipSourceInfo := THIS^.fbSourceInfo, bWithConfirmation := FALSE);
		fbInitError.Raise(0);
	END_IF
	Initialize := E_FAIL;
	RETURN;
END_IF


//Read information from TcCom object
//Get interface to ComObject
hr := FW_ObjMgr_GetObjectInstance(oid:= THIS^.OID, iid:= TC_GLOBAL_IID_LIST.IID_ITComObject, pipUnk:= ADR(THIS^.ipGevImageProviderComObject));
IF THIS^.ipGevImageProviderComObject <> 0 THEN
	//Read object id of TcCom GevImageAcquisitionComObject
	nOid := 0;
	nParaSize := SIZEOF(nOid);	pParaData := ADR(nOid);
	hr := ipGevImageProviderComObject.TcGetObjPara(pid:=N_IDX_OFFSET_GevImageAcquisition , nData:= nParaSize, pData:= pParaData, pgp:=0 );
	
	//Get interface of GevImageAcquisition
	hr := FW_ObjMgr_GetObjectInstance(oid:= nOid, iid:= TC_GLOBAL_IID_LIST.IID_ITComObject, pipUnk:= ADR(THIS^.ipGevImageAcquisitionComObject));
	IF THIS^.ipGevImageAcquisitionComObject <> 0 THEN
		//Read object id of TcCom 
		nOid := 0;
		nParaSize := SIZEOF(nOid);	pParaData := ADR(nOid);
		hr := ipGevImageAcquisitionComObject.TcGetObjPara(pid:=N_IDX_OFFSET_IP_STACK , nData:= nParaSize, pData:= pParaData, pgp:=0 );
		// If IP-Stack was not found in GevImageAcquisitionComObject then camera is in simulation mode
		IF hr = S_OK THEN
			//get interface to ipstack
			hr := FW_ObjMgr_GetObjectInstance(oid:= nOid, iid:= TC_GLOBAL_IID_LIST.IID_ITComObject, pipUnk:= ADR(THIS^.ipIpStackComObject));
		ELSE
			bInSimulation := TRUE;
			hr := S_OK;
		END_IF
	END_IF
END_IF


//Subelement
hr := GetMostSignificant(hr, fbTriggerEtherCat.Initialize());
IF THIS^.ipRegister <> 0 THEN
	hr := GetMostSignificant(hr, THIS^.ipRegister.Initialize());
END_IF


Initialize := hr;

IF Initialize = S_OK THEN
	THIS^.bInitDone := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Initialized" Id="{178783fa-217d-4798-9b8e-d70049fcf541}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
PROPERTY Initialized : BOOL]]></Declaration>
      <Get Name="Get" Id="{56ce6899-32d2-404f-b92a-ec207c58a345}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Initialized := THIS^.bInitDone;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="OID" Id="{d45d7cb9-9db9-405f-b0dc-b7829281ff91}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Returns the OTCID OF the camera object.
PROPERTY OID : CHALET_BaseComponents.OTCID
]]></Declaration>
      <Get Name="Get" Id="{56913cf9-4381-4276-9512-01359e1a5425}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[OID := THIS^.fbCamera.oidITcVnGevImageProvider;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Operational" Id="{9b1561a2-3115-4016-a31a-87faf9e28f65}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
// Module started successfully and entered aquiring mode
PROPERTY PUBLIC Operational : BOOL]]></Declaration>
      <Get Name="Get" Id="{6d77fdf6-f25e-4c00-846a-cd2fdd7d4509}">
        <Declaration><![CDATA[VAR
	eState : ETcVnCameraState;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eState := THIS^.State;
Operational := (eState = TCVN_CS_ACQUIRING) OR (eState = TCVN_CS_TRIGGERING);]]></ST>
        </Implementation>
      </Get>
    </Property>
