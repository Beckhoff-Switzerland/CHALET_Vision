        </Implementation>
      </Get>
      <Set Name="Set" Id="{4feea163-c59c-47aa-b683-c17e4cb21478}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[THIS^.fbRegRegionHeight.Value := RegionHeight;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="RegionOffsetX" Id="{de4cebd3-f65a-4941-8309-58cb4a38b9c9}" FolderPath="RegisterParameter\Region\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Horizontal offset from the origin to the region of interest (in pixels).
PROPERTY RegionOffsetX : UDINT]]></Declaration>
      <Get Name="Get" Id="{7ba345e1-0737-46d7-a9e6-f2599adaf25a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RegionOffsetX := THIS^.fbRegRegionOffsetX.Value;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{a1ffe563-44fd-4b0a-ab90-c3eaf8e7048f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[THIS^.fbRegRegionOffsetX.Value := RegionOffsetX;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="RegionOffsetY" Id="{b572822b-3d6c-4c28-96f4-44978139300c}" FolderPath="RegisterParameter\Region\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Vertical offset in lines of the uppermost pixel relative to the active sensor area.
PROPERTY RegionOffsetY : UDINT]]></Declaration>
