(*This FB can buffer several trigger time stamps. This property shows whether another trigger can be stored.*)
PROPERTY EmptySpaceInBuffer : BOOL
]]></Declaration>
      <Get Name="Get" Id="{7e47dbb0-5ac1-4b40-a401-75786ad95918}">
