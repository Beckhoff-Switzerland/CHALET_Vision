    <Method Name="Reset" Id="{3060e3a3-a4a0-40c3-95ce-133e9b21bdc7}">
      <Declaration><![CDATA[//Try to reset the camera connection
METHOD Reset : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.bResetCommand := TRUE;

fbFeedback.ActiveCommand := 'Reset';
fbFeedback.LastCommandAccepted	:= TRUE;
fbFeedback.hr := THIS^.fbCamera.Reset();	
]]></ST>
      </Implementation>
    </Method>
