<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="VisionParameterlist" Id="{dc7bd9d3-b5d1-4e98-9bc5-16ef928d1db0}" ParameterList="True">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	(*Maximum GigE-Register read/write at same time*)
	MAX_VN_REGISTER_READ_WRITE			: UDINT := 1;
		
	(*Maximum how much the next trigger may be in the future*)
	MAX_NEXT_TRIGGER_IN_FUTURE_ms 		: UDINT := 30_000;
	
	(*This is how much earlier the trigger must be present in the camera in order to take a picture in time. Since V1.2.0 <1ms is posible*)
	CAMERA_TRIGGER_RESPONSE_TIME_ns 	: ULINT := 10;	
	
	(*Number of next triggers that are saved and processed.  1..n*)
	TRIGGER_BUFFER_SIZE 				: UDINT := 1;	
	
	(*For Gige Read/Write leave aquiring state and change to opened state*)
	B_LEAVE_AQUIRRING_STATE_TO_WRITE_PARAMETER : BOOL := TRUE;
	
	(*In the camera's error state, a alarm is generated in the event logger if there is no connection.*)
	B_ALARM_IF_LINK_TO_CAMERA_IS_DOWN : BOOL := TRUE;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>