END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[DeviceDefaultState := THIS^.fbRegDeviceDefaultState.Value;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{91179343-bee6-4894-8b4c-cf2f619f06c9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[THIS^.fbRegDeviceDefaultState.Value := DeviceDefaultState;
]]></ST>
        </Implementation>
      </Set>
    </Property>
