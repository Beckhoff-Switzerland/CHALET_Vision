        </Implementation>
      </Set>
    </Property>
    <Property Name="BrightnessOrange" Id="{6f66be20-6a0e-4a2c-bafa-2f887ae552f4}" FolderPath="RegisterParameter\Lighting\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//The brightness of the channel orange.0-4095
PROPERTY BrightnessOrange : UDINT]]></Declaration>
      <Get Name="Get" Id="{12871479-ffed-4fd7-95a2-b57ffe515095}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[BrightnessOrange := THIS^.fbRegBrightnessOrange.Value;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{3fe7da89-558d-4192-8a42-4418cd81aec0}">
        <Declaration><![CDATA[VAR
