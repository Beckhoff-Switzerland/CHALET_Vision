<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_GigE_Register_Beckhoff_VUI2xxx" Id="{f8c751ef-a351-43ae-94aa-1f4df5d7c1a3}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'no_explicit_call' := 'Do not call the body - Stick to OOP'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK FB_GigE_Register_Beckhoff_VUI2xxx EXTENDS FB_GigE_Register_Beckhoff_VCS2xxx IMPLEMENTS I_GigE_Beckhoff_Lighting, I_GigE_Beckhoff_OpticControl
VAR	

	//GigE-Camera-Register
	//Read/Write Light
	{attribute 'hide'}
	fbRegBrightnessInfrared 	: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pLightController0ChannelBrightnessBaseReg, nEndian := 0);
	{attribute 'hide'}                                                  
	fbRegBrightnessGreen 		: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pLightController0Channel2BrightnessReg, nEndian := 0);
	{attribute 'hide'}                                                  
	fbRegBrightnessOrange 		: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pLightController0Channel3BrightnessReg, nEndian := 0);
	{attribute 'hide'}                                                  
	fbRegBrightnessBlue 		: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pLightController0Channel4BrightnessReg, nEndian := 0);
	//Read/Write Optic control
	{attribute 'hide'}                                                  
	fbRegObjectSensorDistance		: FB_VnRegister_UDINT(bReadOnly := FALSE, nAddress := E_CameraRegisters_Beckhoff.pObjectSensorDistanceReg, nEndian := 0);	                                                                    
 

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="RegisterParameter" Id="{6ea3800c-7f67-45d3-a497-b1fa692a39a7}">
      <Folder Name="Acquisition and Trigger" Id="{48d5e1de-8288-4a77-bca0-240b7ca6d166}" />
      <Folder Name="Device" Id="{e9278f02-5d8d-442c-8602-d9f854936257}" />
      <Folder Name="Lighting" Id="{374f5361-aa16-4a5f-8d33-9083fb85d0b2}" />
      <Folder Name="Optic Control" Id="{32d1e4f2-7ba5-4a39-beea-fc3a3ce93fde}" />
      <Folder Name="Region" Id="{099c3978-b8cf-4b36-8717-51f3894a230a}" />
      <Folder Name="Sensor" Id="{32e64f9a-0c03-4cf0-9f5a-965c97150431}" />
    </Folder>
    <Property Name="BrightnessBlue" Id="{0cbe5b54-ddce-49db-ba18-01d8c611ad67}" FolderPath="RegisterParameter\Lighting\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//The brightness of the channel blue.0-4095
PROPERTY BrightnessBlue : UDINT]]></Declaration>
      <Get Name="Get" Id="{74bafdf9-155b-4be7-ac56-dbc2fe4ff4a9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[BrightnessBlue := THIS^.fbRegBrightnessBlue.Value;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{469cc03d-a557-4b50-8ae8-a77de25dc4c0}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[//0-4095
THIS^.fbRegBrightnessBlue.Value := MIN(BrightnessBlue, 4095);]]></ST>
        </Implementation>
      </Set>
    </Property>
