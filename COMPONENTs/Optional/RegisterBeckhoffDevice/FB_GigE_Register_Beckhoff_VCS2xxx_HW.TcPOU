      </Get>
    </Property>
    <Property Name="Exposure_1us" Id="{2fb107a0-dd72-46df-a510-0303c76f0721}" FolderPath="RegisterParameter\Acquisition and Trigger\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Exposure_1us : UDINT]]></Declaration>
      <Get Name="Get" Id="{40fff91e-8933-4488-bca6-531d47347932}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Exposure_1us := nExposure_1us;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f40aea18-f87e-483d-b430-e33f75a28012}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nExposure_1us := Exposure_1us;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="FB_init" Id="{81d2f840-6ac8-4502-86d4-0dabbfbc2f22}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
	
	ipCamera : I_GigE_Beckhoff_Standalone;
END_VAR
VAR
	ipVnRegisterStatus : I_VnRegister;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Do the following code once during start up and not during onlinechange
IF NOT bInCopyCode THEN 

	//Add this registerparameter to the allready existing list off the "Any" parent

	//Read/Write
	SUPER^.fbVnRegisterList.AddObject(fbRegAcquisitionMode);
	SUPER^.fbVnRegisterList.AddObject(fbRegTriggerMode);
	SUPER^.fbVnRegisterList.AddObject(fbRegTriggerSource);
	SUPER^.fbVnRegisterList.AddObject(fbRegDeviceDefaultState);
	SUPER^.fbVnRegisterList.AddObject(fbRegRegionModeOn);
	SUPER^.fbVnRegisterList.AddObject(fbRegRegionWidth);
	SUPER^.fbVnRegisterList.AddObject(fbRegRegionHeight);
	SUPER^.fbVnRegisterList.AddObject(fbRegRegionOffsetX);
	SUPER^.fbVnRegisterList.AddObject(fbRegRegionOffsetY);
	SUPER^.fbVnRegisterList.AddObject(fbRegGainAnalog);
	
	//Read only
	SUPER^.fbVnRegisterList.AddObject(fbRegDeviceSerialNumber);
	SUPER^.fbVnRegisterList.AddObject(fbRegCurrentIPAddress);
	SUPER^.fbVnRegisterList.AddObject(fbRegGevMACAddressHighWord);
	SUPER^.fbVnRegisterList.AddObject(fbRegGevMACAddressLowWord);
	SUPER^.fbVnRegisterList.AddObject(fbRegImgSensorWidth);
	SUPER^.fbVnRegisterList.AddObject(fbRegImgSensorHeight);

	
	//Link to Camera to allow an parameter to switch the camera in open state
	SUPER^.fbVnRegisterList.ResetIterator();
	WHILE SUPER^.fbVnRegisterList.HasNextObject() DO
		IF __QUERYINTERFACE(SUPER^.fbVnRegisterList.GetNextObject(),ipVnRegisterStatus) THEN
			ipVnRegisterStatus.LinkCamera(ipCamera);
		END_IF
	END_WHILE
	SUPER^.fbVnRegisterList.RestoreIterator();
	
	
	//Prepare for EtherCat-TimeStamp-Trigger use
	THIS^.TriggerSource 		:= E_TriggerSource.EtherCAT;
	THIS^.AcquisitionMode		:= E_AcquisitionModeReg.Continous;
	THIS^.TriggerMode			:= E_TriggerMode.On;
	THIS^.DeviceDefaultState 	:= E_DeviceDefaultState.AutoDetect; 
	THIS^.Exposure_1us 			:= 100;//[us]
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="GainAnalog" Id="{9ad77037-8656-47ef-b004-63e422d58c59}" FolderPath="RegisterParameter\Sensor\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Analog gain in 0.1 dB steps
PROPERTY GainAnalog : LREAL]]></Declaration>
      <Get Name="Get" Id="{15732b8a-5ccf-48fb-a810-11ff4dfecd98}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[GainAnalog := 0.1 * TO_LREAL(THIS^.fbRegGainAnalog.Value);]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{14384796-dca0-4d52-b809-3eaa3d4aac52}">
        <Declaration><![CDATA[VAR
	nIncrements : UINT; //0.1db Steps 0-240Inc.
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nIncrements := TO_UINT(GainAnalog / 0.1);

// >=0
nIncrements := MAX(nIncrements, 0);
	
// <=240
nIncrements := MIN(nIncrements, 240);	

THIS^.fbRegGainAnalog.Value := nIncrements;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="IPAddress" Id="{10ffb7a0-159b-4fd3-aff0-c5e3a562894b}" FolderPath="RegisterParameter\Device\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//IP-Adress as STRING(15)
PROPERTY IPAddress : T_IPv4Addr ]]></Declaration>
      <Get Name="Get" Id="{723567d4-1f67-4a07-8e95-393582ba5685}">
        <Declaration><![CDATA[VAR
	nValueTemp : UDINT;
	stAdressByteArray   : T_IPv4AddrArr; // Byte-Array
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[
IF SIZEOF(fbRegCurrentIPAddress.Value) <> (4*SIZEOF(BYTE)) THEN
	//Error wrond Datatype, Return 0.0.0.0
	IPAddress := F_CreateIPv4Addr(stAdressByteArray);
	RETURN;
END_IF



//store in a temp variable
nValueTemp := fbRegCurrentIPAddress.Value;


//convert to struct(Array of byte)
Tc2_System.MEMCPY(srcAddr:= ADR(nValueTemp)+3, destAddr:= ADR(stAdressByteArray)+0, n:= SIZEOF(BYTE));
Tc2_System.MEMCPY(srcAddr:= ADR(nValueTemp)+2, destAddr:= ADR(stAdressByteArray)+1, n:= SIZEOF(BYTE));
Tc2_System.MEMCPY(srcAddr:= ADR(nValueTemp)+1, destAddr:= ADR(stAdressByteArray)+2, n:= SIZEOF(BYTE));
Tc2_System.MEMCPY(srcAddr:= ADR(nValueTemp)+0, destAddr:= ADR(stAdressByteArray)+3, n:= SIZEOF(BYTE));


IPAddress := F_CreateIPv4Addr(stAdressByteArray); //Byte-Array to String]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="MacAddress" Id="{063802c9-d9e2-4cd8-a01c-afa1e5d0eab8}" FolderPath="RegisterParameter\Device\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//MAC-Adress from camera
PROPERTY MacAddress : STRING(12) ]]></Declaration>
      <Get Name="Get" Id="{d60f600c-6fa0-44e7-8c47-bca4b0879437}">
        <Declaration><![CDATA[VAR

END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT(fbRegGevMACAddressHighWord.ReadDone AND fbRegGevMACAddressLowWord.ReadDone) THEN
	//Wait for first read
	RETURN;
END_IF

MacAddress := Tc2_Standard.CONCAT(
								//This function converts a decimal number into a hexadecimal string (base 16).
								STR1:= Tc2_Utilities.DWORD_TO_HEXSTR(in:= fbRegGevMACAddressHighWord.Value, iPrecision:= 4, bLoCase:= TRUE ), 
								STR2:= Tc2_Utilities.DWORD_TO_HEXSTR(in:= fbRegGevMACAddressLowWord.Value, iPrecision:= 8, bLoCase:= TRUE )
								);

]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="RegionEnable" Id="{ec38f29d-d142-4d2c-9529-e59f9f212102}" FolderPath="RegisterParameter\Region\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Controls if the selected Region of interest is active and streaming.
PROPERTY RegionEnable : BOOL]]></Declaration>
      <Get Name="Get" Id="{990c0859-8649-4e02-a625-80b055dbc5ba}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RegionEnable := (THIS^.fbRegRegionModeOn.Value = 16#01);]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{c903b9ab-02fd-46db-9fcf-5a926190bbb3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF RegionEnable = TRUE THEN
	THIS^.fbRegRegionModeOn.Value := 16#01;
END_IF

IF RegionEnable = FALSE THEN
	THIS^.fbRegRegionModeOn.Value := 16#00;
END_IF
]]></ST>
        </Implementation>
      </Set>
    </Property>
