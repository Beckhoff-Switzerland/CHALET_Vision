      </Get>
      <Set Name="Set" Id="{e9fdde8b-de2f-45b4-8f97-2f2fa6afa45b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[//0-4095
THIS^.fbRegBrightnessGreen.Value := MIN(BrightnessGreen, 4095);]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="BrightnessInfrared" Id="{575b5c51-ff8a-4716-8655-72073b19625f}" FolderPath="RegisterParameter\Lighting\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//The brightness of the channel infrared.0-4095
PROPERTY BrightnessInfrared : UDINT]]></Declaration>
      <Get Name="Get" Id="{1e4849ee-1125-416a-9a88-5bf999db2052}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[BrightnessInfrared := THIS^.fbRegBrightnessInfrared.Value;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{1d68d5a0-989e-4ce5-9768-bcd17392799f}">
