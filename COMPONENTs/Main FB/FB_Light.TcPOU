<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.17">
  <POU Name="FB_Light" Id="{fe151b6c-320b-4024-800a-5be09b9b1c6d}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'no_explicit_call' := 'Do not call the body - Stick to OOP'}
FUNCTION_BLOCK FB_Light EXTENDS FB_CH_Object IMPLEMENTS I_EtherCat_Trigger
VAR
	{attribute 'hide'}	
	bInitDone 						: BOOL;
	{attribute 'hide'}	
	fbTriggerEtherCat				: FB_EtherCAT_Timestamp;	
	{attribute 'hide'}  						
	fbFeedback 			: FB_CH_Feedback(THIS^.fbSourceInfo); 

	bReady					AT %I* 	: BOOL; 
	nBrightnessBlue			AT %Q*	: UINT := N_MAX_BRIGTHNESS; //[0-1000‰]
	nBrightnessGreen		AT %Q*	: UINT := N_MAX_BRIGTHNESS; //[0-1000‰]
	nBrightnessOrange		AT %Q*	: UINT := N_MAX_BRIGTHNESS; //[0-1000‰]
	nBrightnessInfrared		AT %Q*	: UINT := 0; //[0-1000‰]
	nDurationImpuls 		AT %Q*	: UDINT := 10_000;//[ns]
	nTimestamp 				AT %Q*	: T_DCTIME64;			// Trigger time stamp start
END_VAR
VAR CONSTANT
	{attribute 'hide'}	
	N_MAX_BRIGTHNESS 				: UINT := 1000; //[0-1000‰]
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="BrightnessBluePermille" Id="{7c7bd60d-d34c-4ba9-babc-c317cfe3f169}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//The brightness of the channel blue. [0-1000‰]
PROPERTY BrightnessBluePermille : UINT]]></Declaration>
      <Get Name="Get" Id="{d9338410-2ab4-4589-91b8-686d5737973f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[BrightnessBluePermille := nBrightnessBlue;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{04f34b19-14aa-4d93-9c08-7d6d494faf15}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[//LIMIT(min,in,max) Returns in if it lies in the interval [min,max]. Otherwise, the violated bound (min or max) is returned.
 nBrightnessBlue := LIMIT(0, BrightnessBluePermille, N_MAX_BRIGTHNESS);
]]></ST>
        </Implementation>
      </Set>
    </Property>
