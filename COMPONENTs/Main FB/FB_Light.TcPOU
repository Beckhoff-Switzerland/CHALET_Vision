      </Get>
    </Property>
    <Property Name="Feedback" Id="{081479ae-7647-4e4a-b144-457ff8f93dfe}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
PROPERTY Feedback : I_CH_Feedback]]></Declaration>
      <Get Name="Get" Id="{1ddd259f-0ae2-4975-889a-bd4f1fdf0211}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Feedback := THIS^.fbFeedback;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Initialize" Id="{573004b0-2ea0-47c5-b142-5e4213ca69ef}">
      <Declaration><![CDATA[METHOD Initialize : HRESULT
VAR 
	hr : HRESULT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[hr := SUPER^.Initialize();

//Subelement
hr := GetMostSignificant(hr, fbTriggerEtherCat.Initialize());

Initialize := hr;

IF Initialize = S_OK THEN
	THIS^.bInitDone := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Initialized" Id="{fbae047b-72df-4e08-84c8-3f057bb1b65d}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
PROPERTY Initialized : BOOL]]></Declaration>
      <Get Name="Get" Id="{437d30f9-41cf-4c96-a0d3-e303704cb250}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Initialized := THIS^.bInitDone;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="LastTriggerTime" Id="{05ed97a3-88bb-49f9-9a4f-f53daec1a392}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//[ns]
PROPERTY LastTriggerTime : T_DCTIME64
]]></Declaration>
      <Get Name="Get" Id="{5107b451-2d0f-472a-a455-dec157643ebe}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[LastTriggerTime := fbTriggerEtherCat.LastTriggerTime;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Mapped" Id="{9f5a588e-70f4-4f68-bbb1-4a7f562ac25b}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
(*FB is mapped to hardware*)
PROPERTY Mapped : BOOL
]]></Declaration>
      <Get Name="Get" Id="{8bcd8b12-651a-480a-bf4b-a07db1839f51}">
        <Declaration><![CDATA[VAR
	bNotMapped 	: BOOL;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bNotMapped := bNotMapped OR F_GetMappingStatus(ADR(THIS^.nBrightnessBlue), SIZEOF(THIS^.nBrightnessBlue)) <> EPlcMappingStatus.MS_Mapped;
bNotMapped := bNotMapped OR F_GetMappingStatus(ADR(THIS^.nBrightnessGreen), SIZEOF(THIS^.nBrightnessGreen)) <> EPlcMappingStatus.MS_Mapped;
bNotMapped := bNotMapped OR F_GetMappingStatus(ADR(THIS^.nBrightnessInfrared), SIZEOF(THIS^.nBrightnessInfrared)) <> EPlcMappingStatus.MS_Mapped;
bNotMapped := bNotMapped OR F_GetMappingStatus(ADR(THIS^.nBrightnessOrange), SIZEOF(THIS^.nBrightnessOrange)) <> EPlcMappingStatus.MS_Mapped;

Mapped := NOT bNotMapped;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="TaskCycleTime" Id="{92bc739a-c562-452c-a891-5293bacfccf4}">
      <Declaration><![CDATA[(*Cycle time in ns. This can be helpful for calculating the next trigger.*)
PROPERTY TaskCycleTime : UDINT
]]></Declaration>
      <Get Name="Get" Id="{e07ea42e-8d58-438d-9a5f-a7d1032c13e7}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[TaskCycleTime := fbTriggerEtherCat.TaskCycleTime;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Trigger" Id="{13a9cea9-8cbf-4fba-9569-424f57be4c5d}">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD Trigger : HRESULT
VAR_INPUT
	(*The data type T_DCTIME64 represents the distributed clock system time (abbreviated as DC time) as a linear 64-bit integer value. 
The time is expressed in nanoseconds since 1/1/2000 UTC. The smallest unit is a nanosecond.
F_GetCurDcTickTime64()*)
	nDCTimeStamp	: T_DCTIME64;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="Update" Id="{804946a9-cf33-4ba0-8bdd-dc3f156ace92}">
      <Declaration><![CDATA[METHOD Update : HRESULT
VAR
	hr : HRESULT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Force to initialize first
IF NOT THIS^.Initialized THEN
	THIS^.Initialize();
	RETURN;
END_IF

//Subelement - if not in simulation
fbTriggerEtherCat.Update();



//Check for errors
IF NOT THIS^.bReady THEN
	THIS^.fbFeedback.ErrorID := Global.E_Win32EventClass.ERROR_NOT_READY;
ELSE	
	THIS^.fbFeedback.hr := fbTriggerEtherCat.Feedback.HR;
END_IF



//Write Outputs
THIS^.nTimestamp := fbTriggerEtherCat.nTimestamp;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>