    <Method Name="Update" Id="{dfcd320b-b25c-4f86-9d05-5d54c5d20c1f}">
      <Declaration><![CDATA[METHOD Update : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//If the connection to vision is in state "Opene" try to read or write parameters
IF (THIS^.ipCamera <> 0) AND_THEN THIS^.ipCamera.GevCameraControl.GetState() = TCVN_CS_OPENED THEN
	THIS^.fbVnRegisterList.Update();
END_IF
]]></ST>
      </Implementation>
    </Method>
