<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <GVL Name="VisionParameterlist" Id="{dc7bd9d3-b5d1-4e98-9bc5-16ef928d1db0}" ParameterList="True">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	(*Maximum GigE-Register read/write at same time*)
	MAX_VN_REGISTER_READ_WRITE			: UDINT := 1;
		
	(*Maximum how much the next trigger may be in the future*)
	MAX_NEXT_TRIGGER_IN_FUTURE_ms 		: UDINT := 10_000;
	
	(*This is how much earlier the trigger must be present in the camera in order to take a picture in time*)
	CAMERA_TRIGGER_RESPONSE_TIME_ns 	: ULINT := 3_000_000;	
	
	(*Number of next triggers that are saved and processed.  1..n*)
	TRIGGER_BUFFER_SIZE 				: UDINT := 1;	
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>