        </Implementation>
      </Get>
      <Set Name="Set" Id="{cc3db4b2-20ef-494b-bac9-037f43d434db}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[//LIMIT(min,in,max) Returns in if it lies in the interval [min,max]. Otherwise, the violated bound (min or max) is returned.
 nBrightnessGreen := LIMIT(0, BrightnessGreenPermille, N_MAX_BRIGTHNESS);
]]></ST>
        </Implementation>
      </Set>
    </Property>
