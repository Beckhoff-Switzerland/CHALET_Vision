      <Get Name="Get" Id="{1c6fb4c2-c34b-47fb-ad3a-1d4199dac7a7}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[fbRegDeviceVersion.ReadData(ADR(DeviceVersion));]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Exposure_1us" Id="{9c41c965-62da-4a60-b8bd-a89a1fe1642d}" FolderPath="RegisterParameter\Acquisition and Trigger\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Exposure_1us : UDINT]]></Declaration>
      <Get Name="Get" Id="{b04c876e-18dc-43fb-908e-5629b46c781d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Exposure_1us := THIS^.fbRegExposureTime.Value;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{617189e7-d42c-49c8-83d6-a03f6910b168}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[THIS^.fbRegExposureTime.Value := Exposure_1us;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="FB_init" Id="{07eb15c8-e3c3-4bc2-9e87-ad285d7e7049}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
	
	ipCamera : I_GevCameraControl;
END_VAR
VAR
	ipVnRegisterStatus : I_VnRegister;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//Do the following code once during start up and not during onlinechange
IF NOT bInCopyCode THEN 
	
	THIS^.ipCamera := ipCamera;

	//Read/Write
	fbVnRegisterList.AddObject(fbRegAcquisitionMode);
	fbVnRegisterList.AddObject(fbRegTriggerMode);
	fbVnRegisterList.AddObject(fbRegTriggerSource);
	fbVnRegisterList.AddObject(fbRegExposureTime);
	fbVnRegisterList.AddObject(fbRegDeviceDefaultState);
	fbVnRegisterList.AddObject(fbRegRegionModeOn);
	fbVnRegisterList.AddObject(fbRegRegionWidth);
	fbVnRegisterList.AddObject(fbRegRegionHeight);
	fbVnRegisterList.AddObject(fbRegRegionOffsetX);
	fbVnRegisterList.AddObject(fbRegRegionOffsetY);
	fbVnRegisterList.AddObject(fbRegGainAnalog);
	
	//Read only
	fbVnRegisterList.AddObject(fbRegDeviceVendorName);
	fbVnRegisterList.AddObject(fbRegDeviceModelName);
	fbVnRegisterList.AddObject(fbRegSensorName);
	fbVnRegisterList.AddObject(fbRegDeviceVersion);
	fbVnRegisterList.AddObject(fbRegDeviceSerialNumber);
	fbVnRegisterList.AddObject(fbRegCurrentIPAddress);
	fbVnRegisterList.AddObject(fbRegGevMACAddressHighWord);
	fbVnRegisterList.AddObject(fbRegGevMACAddressLowWord);
	fbVnRegisterList.AddObject(fbRegImgSensorWidth);
	fbVnRegisterList.AddObject(fbRegImgSensorHeight);
	
	
	//Link to Camera to allow an parameter to switch the camera in open state
	THIS^.fbVnRegisterList.ResetIterator();
	WHILE THIS^.fbVnRegisterList.HasNextObject() DO
		IF __QUERYINTERFACE(THIS^.fbVnRegisterList.GetNextObject(),ipVnRegisterStatus) THEN
			ipVnRegisterStatus.LinkCamera(ipCamera);
		END_IF
	END_WHILE
	THIS^.fbVnRegisterList.RestoreIterator();
	
	
	//Prepare for EtherCat-TimeStamp-Trigger use
	THIS^.TriggerSource 		:= E_TriggerSource.EtherCAT;
	THIS^.AcquisitionMode		:= E_AcquisitionModeReg.Continous;
	THIS^.TriggerMode			:= E_TriggerMode.On;
	THIS^.DeviceDefaultState 	:= E_DeviceDefaultState.AutoDetect; 
	THIS^.Exposure_1us 			:= 100;//[us]
	
//	//Set some valide values
//	THIS^.RegionHeight			:= 400;
//	THIS^.RegionWidth			:= 400;
//	THIS^.RegionOffsetX			:= 0;
//	THIS^.RegionOffsetY			:= 0;
		
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="GainAnalog" Id="{d3d2aebc-6313-46d0-947f-ed5d24d21bc8}" FolderPath="RegisterParameter\Sensor\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Analog gain in 0.1 dB steps
PROPERTY GainAnalog : LREAL]]></Declaration>
      <Get Name="Get" Id="{1a338836-888b-4c62-963e-9acc3399066f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[GainAnalog := 0.1 * TO_LREAL(THIS^.fbRegGainAnalog.Value);]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{cfa97108-54b6-44b4-86c1-54bc78db566b}">
        <Declaration><![CDATA[VAR
	nIncrements : UINT; //0.1db Steps 0-240Inc.
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nIncrements := TO_UINT(GainAnalog / 0.1);

// >=0
nIncrements := MAX(nIncrements, 0);
	
// <=240
nIncrements := MIN(nIncrements, 240);	

THIS^.fbRegGainAnalog.Value := nIncrements;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Initialize" Id="{c2d6eef4-6794-4c59-bc63-f2294ecf2a1a}">
      <Declaration><![CDATA[METHOD Initialize : HRESULT
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reset all read and write flags 
Initialize := THIS^.fbVnRegisterList.Initialize();]]></ST>
      </Implementation>
    </Method>
    <Property Name="IPAddress" Id="{1fb51da5-1faf-4b4a-9843-e4da33f59764}" FolderPath="RegisterParameter\Device\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//IP-Adress as STRING(15)
PROPERTY IPAddress : T_IPv4Addr ]]></Declaration>
      <Get Name="Get" Id="{a5352a5c-7ce0-444c-b895-bae3a0215352}">
        <Declaration><![CDATA[VAR
	nValueTemp : UDINT;
	stAdressByteArray   : T_IPv4AddrArr; // Byte-Array
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[
IF SIZEOF(fbRegCurrentIPAddress.Value) <> (4*SIZEOF(BYTE)) THEN
	//Error wrond Datatype, Return 0.0.0.0
	IPAddress := F_CreateIPv4Addr(stAdressByteArray);
	RETURN;
END_IF



//store in a temp variable
nValueTemp := fbRegCurrentIPAddress.Value;


//convert to struct(Array of byte)
Tc2_System.MEMCPY(srcAddr:= ADR(nValueTemp)+3, destAddr:= ADR(stAdressByteArray)+0, n:= SIZEOF(BYTE));
Tc2_System.MEMCPY(srcAddr:= ADR(nValueTemp)+2, destAddr:= ADR(stAdressByteArray)+1, n:= SIZEOF(BYTE));
Tc2_System.MEMCPY(srcAddr:= ADR(nValueTemp)+1, destAddr:= ADR(stAdressByteArray)+2, n:= SIZEOF(BYTE));
Tc2_System.MEMCPY(srcAddr:= ADR(nValueTemp)+0, destAddr:= ADR(stAdressByteArray)+3, n:= SIZEOF(BYTE));


IPAddress := F_CreateIPv4Addr(stAdressByteArray); //Byte-Array to String]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="MacAddress" Id="{e0a424d2-01ce-4866-bb40-a6c6f58823fc}" FolderPath="RegisterParameter\Device\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//MAC-Adress from camera
PROPERTY MacAddress : STRING(12) ]]></Declaration>
      <Get Name="Get" Id="{abb82e33-502f-4cf7-8efa-5b6ef1884c1d}">
        <Declaration><![CDATA[VAR

END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF NOT(fbRegGevMACAddressHighWord.ReadDone AND fbRegGevMACAddressLowWord.ReadDone) THEN
	//Wait for first read
	RETURN;
END_IF

MacAddress := Tc2_Standard.CONCAT(
								//This function converts a decimal number into a hexadecimal string (base 16).
								STR1:= Tc2_Utilities.DWORD_TO_HEXSTR(in:= fbRegGevMACAddressHighWord.Value, iPrecision:= 4, bLoCase:= TRUE ), 
								STR2:= Tc2_Utilities.DWORD_TO_HEXSTR(in:= fbRegGevMACAddressLowWord.Value, iPrecision:= 8, bLoCase:= TRUE )
								);

]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="RegionEnable" Id="{75431256-5337-4fbc-b9a9-db86ed8b01ca}" FolderPath="RegisterParameter\Region\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Controls if the selected Region of interest is active and streaming.
PROPERTY RegionEnable : BOOL]]></Declaration>
      <Get Name="Get" Id="{37dc7639-d0ba-4ed8-82c9-cb63e5c86b91}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RegionEnable := (THIS^.fbRegRegionModeOn.Value = 16#01);]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{634963f9-002e-4f2c-96a6-69c8a0f2b841}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF RegionEnable = TRUE THEN
	THIS^.fbRegRegionModeOn.Value := 16#01;
END_IF

IF RegionEnable = FALSE THEN
	THIS^.fbRegRegionModeOn.Value := 16#00;
END_IF
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="RegionHeight" Id="{c13b9ead-d18d-4ad4-a238-8839251cc104}" FolderPath="RegisterParameter\Region\">
