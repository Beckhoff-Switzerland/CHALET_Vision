    <Method Name="TriggerImage" Id="{3c95bf52-6f2e-4e95-8364-3123a725a37e}">
      <Declaration><![CDATA[//If in trigger mode, this function triggers the next image in the list.
METHOD TriggerImage : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
    </Method>
    <Method Name="TriggerImageByName" Id="{54d9b3c8-8e78-4905-800b-f6cef53e8e7c}">
      <Declaration><![CDATA[//If in trigger mode, this function triggers a specific image in the list by name.
METHOD TriggerImageByName : HRESULT
VAR_INPUT
	//Name of the image to trigger
	sImageName : STRING;
END_VAR
]]></Declaration>
    </Method>
    <Method Name="TriggerImageExp" Id="{f96bc3c8-21c6-4bb9-b36f-505c92304db9}">
      <Declaration><![CDATA[//If in trigger mode, this function triggers a specific image in the list.
METHOD TriggerImageExp : HRESULT
VAR_INPUT
	//Amount of images to skip, relative to current
	nSkipImages : DINT;
END_VAR
]]></Declaration>
    </Method>
    <Method Name="TryGetImage" Id="{fa4dd77f-1582-4435-9514-a789b874aa73}">
      <Declaration><![CDATA[//Gets the current available image (first in receive queue) and its corresponding GVSP info
