    </Folder>
    <Property Name="AcquisitionMode" Id="{ef244aed-f1df-4463-8d79-7a3b36a831f6}" FolderPath="RegisterParameter\Acquisition and Trigger\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Number of frames captured in the acquisition. 
//SingleFrame: One frame is captured. 
//MultiFrame: The number of frames specified by AcquisitionFrameCount is captured. 
//Continuous: Frames are captured continuously until stopped with the AcquisitionStop command.
PROPERTY AcquisitionMode : E_AcquisitionModeReg]]></Declaration>
      <Get Name="Get" Id="{9ad73c05-11a1-473e-bd5b-d01ba5e68f28}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[AcquisitionMode := THIS^.fbRegAcquisitionMode.Value;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{616420e8-fc7a-4544-a8ab-822cd7fae41f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[fbRegAcquisitionMode.Value := AcquisitionMode;

]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="AllReadDone" Id="{91c45d14-822a-40f7-abd4-7dcecfaf6f2a}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY AllReadDone : BOOL]]></Declaration>
      <Get Name="Get" Id="{f61b7ae1-04fd-4013-a8b3-dafe52d2cb22}">
        <Declaration><![CDATA[VAR
	ipVnRegisterStatus : I_VnRegister;
	bAllRead : BOOL := TRUE;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[THIS^.fbVnRegisterList.ResetIterator();
WHILE THIS^.fbVnRegisterList.HasNextObject() DO
	IF __QUERYINTERFACE(THIS^.fbVnRegisterList.GetNextObject(),ipVnRegisterStatus) THEN
		bAllRead := bAllRead AND ipVnRegisterStatus.ReadDone;
	END_IF
END_WHILE
THIS^.fbVnRegisterList.RestoreIterator();
		
AllReadDone := bAllRead;		
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{65c509b9-6b77-475f-83f0-e73720e33772}">
        <Declaration><![CDATA[VAR
	ipRegObject : I_VnRegister;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF AllReadDone = FALSE THEN
	THIS^.fbVnRegisterList.ResetIterator();
	WHILE(THIS^.fbVnRegisterList.HasNextObject()) DO
		IF __QUERYINTERFACE(THIS^.fbVnRegisterList.GetNextObject(), ipRegObject) THEN
			ipRegObject.ReadDone := FALSE;
		END_IF
	END_WHILE
	THIS^.fbVnRegisterList.RestoreIterator();
END_IF

]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="AllWriteDone" Id="{3ef6b466-38a3-44e5-99cc-88f719c98ae4}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY AllWriteDone : Bool]]></Declaration>
      <Get Name="Get" Id="{44dae8b1-46a4-4942-b701-c96223612070}">
        <Declaration><![CDATA[VAR
	ipVnRegisterStatus : I_VnRegister;
	bAllWritten : BOOL := TRUE;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[THIS^.fbVnRegisterList.ResetIterator();
WHILE THIS^.fbVnRegisterList.HasNextObject() DO
	IF __QUERYINTERFACE(THIS^.fbVnRegisterList.GetNextObject(),ipVnRegisterStatus) THEN
		bAllWritten := bAllWritten AND ipVnRegisterStatus.WriteDone;
	END_IF
END_WHILE
THIS^.fbVnRegisterList.RestoreIterator();
		
AllWriteDone := bAllWritten;		
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{1ce2c662-c182-4dfe-8b52-fa0e074612df}">
        <Declaration><![CDATA[VAR
	ipRegObject : I_VnRegister;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF AllWriteDone = FALSE THEN
	THIS^.fbVnRegisterList.ResetIterator();
	WHILE(THIS^.fbVnRegisterList.HasNextObject()) DO
		IF __QUERYINTERFACE(THIS^.fbVnRegisterList.GetNextObject(), ipRegObject) THEN
			ipRegObject.WriteDone := FALSE;
		END_IF
	END_WHILE
	THIS^.fbVnRegisterList.RestoreIterator();
END_IF

]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="DeviceDefaultState" Id="{34afc0de-dcf7-4be5-86e8-f98969a9d7fd}" FolderPath="RegisterParameter\Device\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
//Controls whether most of the camera settings is controlled by GigE Vision or EtherCAT. 
//A change from EtherCAT to GigE Vision requires a reboot.
PROPERTY DeviceDefaultState : E_DeviceDefaultState]]></Declaration>
      <Get Name="Get" Id="{7664beb5-88fa-4201-8791-0677c3cab887}">
